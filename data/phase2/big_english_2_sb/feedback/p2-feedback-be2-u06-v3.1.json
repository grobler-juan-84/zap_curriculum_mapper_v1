  "language_structures": [
    {
      "id": "STR-01",
      "name": "Asking and Telling the Time (o'clock)",
      "instructional_role": "main_target",
      "pattern": "What time is it? / It's [number] o'clock.",
      "source_examples": [
        "What time is it? It's one o'clock.",
        "Tick, tock. It's seven o'clock."
      ],
      "plain_english_explanation": "Use 'What time is it?' to ask the hour, and answer with 'It's' followed by the number and 'o'clock'.",
      "components": [
        {
          "name": "Time Question Frame",
          "explanation": "Fixed phrase 'What time is it?' used to request the current time."
        },
        {
          "name": "Hourly Time Statement",
          "explanation": "Subject-verb contraction 'It's' + cardinal number (one to twelve) + 'o'clock'."
        }
      ],
      "evidence_refs": [
        "bep2_lang_u6_001",
        "bep2_act_u6_01",
        "bep2_act_u6_04",
        "bep2_act_u6_06",
        "bep2_text_u6_01",
        "bep2_act_u6_36"
      ]
    },
    {
      "id": "STR-02",
      "name": "Asking and Talking About Daily Routine Times",
      "instructional_role": "main_target",
      "pattern": "When do/does [subject] [base verb]? / [Subject] [verb(-s/-es)] at [time].",
      "source_examples": [
        "When does he get up? He gets up at 6:00.",
        "When do you go to bed? I go to bed at 8:00."
      ],
      "plain_english_explanation": "Use 'When do' or 'When does' to ask about routine times, and answer with the verb phrase and 'at' plus the specific time.",
      "components": [
        {
          "name": "Wh- Routine Question",
          "explanation": "Question word 'When' + helping verb 'do/does' + subject pronoun + base routine verb."
        },
        {
          "name": "Time Preposition Phrase",
          "explanation": "Preposition 'at' followed by clock time (either written or numeric)."
        },
        {
          "name": "Subject-Verb Agreement in Present Simple",
          "explanation": "Base verb with 'I/you/we/they' (e.g., 'go') vs. '-s/-es' inflection with 'he/she/it' (e.g., 'gets up', 'eats')."
        }
      ],
      "evidence_refs": [
        "bep2_lang_u6_002",
        "bep2_lang_u6_003",
        "bep2_act_u6_09",
        "bep2_act_u6_10",
        "bep2_act_u6_12",
        "bep2_text_u6_02"
      ]
    },
    {
      "id": "STR-03",
      "name": "Stating Event Schedules with Start and Finish",
      "instructional_role": "main_target",
      "pattern": "When does [event] start/finish? / It starts/finishes at [time].",
      "source_examples": [
        "When does the movie start? It starts at 8:00.",
        "When does the movie end? It ends at 10:00."
      ],
      "plain_english_explanation": "Ask when scheduled activities begin or end using 'start' or 'finish'/'end', and answer with 'It starts/finishes at' plus the time.",
      "components": [
        {
          "name": "Event Schedule Question",
          "explanation": "'When does' + noun phrase + 'start/finish'?"
        },
        {
          "name": "Event Schedule Response",
          "explanation": "Pronoun 'It' + 3rd person singular verb ('starts' / 'finishes' / 'ends') + 'at' + time."
        }
      ],
      "evidence_refs": [
        "bep2_lang_u6_004",
        "bep2_act_u6_13"
      ]
    },
    {
      "id": "STR-04",
      "name": "Forming Wh- Questions with Be and Do",
      "instructional_role": "main_target",
      "pattern": "[Wh- word] + [be / do / does] + [subject] (+ [base verb])?",
      "source_examples": [
        "Who are you?",
        "What's your job?",
        "Where do you work?",
        "How do you get to work?",
        "When do you work?",
        "How many students are in your class?"
      ],
      "plain_english_explanation": "Choose the right question word (Who, What, Where, When, How, How many) depending on the requested information, followed by the correct helping or linking verb.",
      "components": [
        {
          "name": "Wh- Question Word Selection",
          "explanation": "'Who' (person), 'What' (thing/job), 'Where' (place), 'When' (time/day), 'How' (manner/means), 'How many' (quantity)."
        },
        {
          "name": "Inversion with Helping/Linking Verb",
          "explanation": "Placing 'is/are' or auxiliary 'do/does' directly before the subject."
        }
      ],
      "evidence_refs": [
        "bep2_lang_u6_005",
        "bep2_act_u6_19",
        "bep2_act_u6_20",
        "bep2_act_u6_21",
        "bep2_act_u6_22",
        "bep2_act_u6_23",
        "bep2_act_u6_24",
        "bep2_text_u6_04",
        "bep2_act_u6_37"
      ]
    },
    {
      "id": "STR-05",
      "name": "Describing Mechanisms with Present Simple",
      "instructional_role": "supporting",
      "pattern": "[Subject] uses [means/substance] to tell the time.",
      "source_examples": [
        "A sundial uses the sun to tell the time.",
        "An hourglass uses sand to tell the time."
      ],
      "plain_english_explanation": "State what instrument or material an object operates with using 'uses' + noun + 'to tell the time'.",
      "components": [
        {
          "name": "Instrument + Purpose Clause",
          "explanation": "Singular noun + 'uses' + noun + infinitive of purpose 'to tell the time'."
        }
      ],
      "evidence_refs": [
        "bep2_act_u6_15",
        "bep2_act_u6_17",
        "bep2_text_u6_03",
        "bep2_act_u6_38"
      ]
    },
    {
      "id": "STR-06",
      "name": "Consonant Digraphs and Trigraphs (ch, tch, sh)",
      "instructional_role": "main_target",
      "pattern": "Sound-spelling patterns: /tʃ/ spelled 'ch' or 'tch', and /ʃ/ spelled 'sh'",
      "source_examples": [
        "chin, rich, chop, lunch",
        "witch, match, watch",
        "ship, fish, she, dish"
      ],
      "plain_english_explanation": "Recognize and pronounce the /tʃ/ sound spelled with 'ch' or 'tch' and the /ʃ/ sound spelled with 'sh' in word-initial and word-final positions.",
      "components": [
        {
          "name": "Affricate vs. Fricative Distinction",
          "explanation": "Distinguishing the stop-release /tʃ/ ('ch'/'tch') from the continuous /ʃ/ ('sh')."
        },
        {
          "name": "Spelling Pattern: -tch",
          "explanation": "The trigraph 'tch' used after a short vowel at the end of a syllable (e.g., 'witch', 'match', 'watch')."
        }
      ],
      "evidence_refs": [
        "bep2_act_u6_31",
        "bep2_act_u6_32",
        "bep2_act_u6_33",
        "bep2_act_u6_34",
        "bep2_text_u6_06"
      ]
    }
  ],
