  "language_structures": [
    {
      "id": "STR-01",
      "name": "Asking and answering about actions happening now (singular)",
      "instructional_role": "main_target",
      "pattern": "What's [he / she] doing? -> [He's / She's] [verb-ing] [noun / complement].",
      "source_examples": [
        "What's she doing? She's coloring.",
        "What's she doing? She's using the computer."
      ],
      "plain_english_explanation": "Use 'What's he/she doing?' to ask about an action in progress right now, and answer with 'He's' or 'She's' followed by an -ing action verb.",
      "components": [
        {
          "name": "Question frame",
          "explanation": "Question word 'What' combined with contracted helping verb 's (is) and subject pronoun."
        },
        {
          "name": "Present continuous verb phrase",
          "explanation": "Subject pronoun contracted with 'is' (He's / She's) plus a verb ending in -ing."
        }
      ],
      "evidence_refs": ["bep2_lang_u1_001", "bep2_lang_u1_002", "bep2_act_u1_06", "bep2_act_u1_10"]
    },
    {
      "id": "STR-02",
      "name": "Asking and answering about actions happening now (plural)",
      "instructional_role": "main_target",
      "pattern": "What are they doing? -> They're [verb-ing] [noun / complement].",
      "source_examples": [
        "What are they doing? They're gluing."
      ],
      "plain_english_explanation": "Use 'What are they doing?' to ask about two or more people's current actions, and answer with 'They're' plus an -ing verb.",
      "components": [
        {
          "name": "Plural question frame",
          "explanation": "'What are' followed by the plural pronoun 'they' and 'doing'."
        },
        {
          "name": "Plural response phrase",
          "explanation": "Contracted subject and helping verb 'They're' (They are) followed by the -ing verb form."
        }
      ],
      "evidence_refs": ["bep2_lang_u1_003", "bep2_act_u1_09", "bep2_act_u1_10", "bep2_act_u1_34"]
    },
    {
      "id": "STR-03",
      "name": "Asking and answering about quantities using There is / There are",
      "instructional_role": "main_target",
      "pattern": "How many [plural noun] are there? -> There's [one singular noun] / There are [number] [plural noun].",
      "source_examples": [
        "How many computers are there? There are two computers.",
        "How many Marias are there? There are two Marias."
      ],
      "plain_english_explanation": "Ask about quantity with 'How many' plus a plural noun and 'are there?'. Answer with 'There's' for one item or 'There are' for more than one.",
      "components": [
        {
          "name": "Quantity question phrase",
          "explanation": "'How many' followed by plural count noun and inverted helping verb 'are there'."
        },
        {
          "name": "Existential statement",
          "explanation": "'There's' with a single item or 'There are' with a count greater than one."
        }
      ],
      "evidence_refs": ["bep2_lang_u1_004", "bep2_act_u1_07", "bep2_act_u1_12", "bep2_act_u1_13", "bep2_act_u1_36"]
    },
    {
      "id": "STR-04",
      "name": "Classroom rules and instructions (Imperatives)",
      "instructional_role": "main_target",
      "pattern": "[Base verb] [complement]. / Don't [base verb] [complement].",
      "source_examples": [
        "Stand on the chair. / Don't stand on the table.",
        "Be careful. / Don't be silly."
      ],
      "plain_english_explanation": "Give direct instructions or rules by starting directly with a base verb. To tell someone not to do something, start with 'Don't' followed by the base verb.",
      "components": [
        {
          "name": "Affirmative imperative",
          "explanation": "Begins directly with the base form of the verb without a stated subject pronoun."
        },
        {
          "name": "Negative imperative",
          "explanation": "'Don't' placed immediately before the base verb to prohibit an action."
        }
      ],
      "evidence_refs": ["bep2_lang_u1_005", "bep2_act_u1_20", "bep2_act_u1_21", "bep2_act_u1_22", "bep2_act_u1_23", "bep2_act_u1_35"]
    },
    {
      "id": "STR-05",
      "name": "Stating math equations",
      "instructional_role": "supporting",
      "pattern": "[Number] [plus / minus] [number] equals [number].",
      "source_examples": [
        "Four plus three equals seven.",
        "Eight minus two equals six."
      ],
      "plain_english_explanation": "Say basic addition and subtraction problems aloud by joining numbers with 'plus' or 'minus' and finishing with 'equals'.",
      "components": [
        {
          "name": "Arithmetic operators",
          "explanation": "Prepositions 'plus' for addition and 'minus' for subtraction."
        },
        {
          "name": "Equation verb",
          "explanation": "'Equals' used as the third-person singular linking verb."
        }
      ],
      "evidence_refs": ["bep2_act_u1_14", "bep2_act_u1_17"]
    },
    {
      "id": "STR-06",
      "name": "Asking permission and making suggestions",
      "instructional_role": "supporting",
      "pattern": "May I [base verb] [noun]? -> Yes! Let's [base verb].",
      "source_examples": [
        "May I use the computer now? Yes! Let's take turns."
      ],
      "plain_english_explanation": "Use 'May I' to ask polite permission to do something, and 'Let's' to suggest doing an action together.",
      "components": [
        {
          "name": "Polite permission frame",
          "explanation": "Modal verb 'May' placed before subject 'I' and base verb."
        },
        {
          "name": "Cooperative suggestion",
          "explanation": "'Let's' (Let us) followed by a base verb phrase."
        }
      ],
      "evidence_refs": ["bep2_lang_u1_006", "bep2_act_u1_29"]
    }
  ],
  "foundational_skills": [
    {
      "id": "FS-01",
      "name": "Pronoun-verb contraction recognition (He's, She's, They're)",
      "explanation": "Recognizing and forming spoken and written contractions of subject pronouns with the helping verb 'is' and 'are' (he's, she's, they're).",
      "related_structure_ids": ["STR-01", "STR-02"],
      "teaching_status": "implicit",
      "frequent_reinforcement_candidate": true,
      "evidence_refs": ["bep2_p008", "bep2_lang_u1_002", "bep2_lang_u1_003"]
    },
    {
      "id": "FS-02",
      "name": "Forming -ing action verbs with spelling changes",
      "explanation": "Adding -ing to base verbs, including dropping final silent -e (write -> writing, use -> using) and doubling single final consonants (cut -> cutting).",
      "related_structure_ids": ["STR-01", "STR-02"],
      "teaching_status": "implicit",
      "frequent_reinforcement_candidate": true,
      "evidence_refs": ["bep2_p004", "bep2_vocab_u1_003", "bep2_vocab_u1_007", "bep2_vocab_u1_008"]
    },
    {
      "id": "FS-03",
      "name": "Singular vs. plural existential selection (There's vs. There are)",
      "explanation": "Selecting 'There's' when followed by one person or thing, and 'There are' when followed by two or more.",
      "related_structure_ids": ["STR-03"],
      "teaching_status": "implicit",
      "frequent_reinforcement_candidate": true,
      "evidence_refs": ["bep2_p009", "bep2_act_u1_13", "bep2_act_u1_36"]
    },
    {
      "id": "FS-04",
      "name": "Affirmative vs. negative imperative contrast",
      "explanation": "Distinguishing positive instructions (Listen) from prohibitions (Don't talk) by adding or removing 'Don't' before the base verb.",
      "related_structure_ids": ["STR-04"],
      "teaching_status": "explicit",
      "frequent_reinforcement_candidate": true,
      "evidence_refs": ["bep2_p012", "bep2_act_u1_20", "bep2_act_u1_21", "bep2_act_u1_23"]
    },
    {
      "id": "FS-05",
      "name": "Phonemic discrimination and articulation of unvoiced and voiced digraph /θ/ and /ð/",
      "explanation": "Distinguishing and pronouncing the unvoiced /θ/ sound (bath, thin, math) and voiced /ð/ sound (this, that, then, with).",
      "related_structure_ids": [],
      "teaching_status": "explicit",
      "frequent_reinforcement_candidate": true,
      "evidence_refs": ["bep2_p017", "bep2_act_u1_30", "bep2_act_u1_31", "bep2_act_u1_32", "bep2_act_u1_33"]
    },
    {
      "id": "FS-06",
      "name": "Auditory number discrimination between -teen and -ty numbers",
      "explanation": "Distinguishing between similar-sounding teen and tens numbers (e.g., 17 vs. 70).",
      "related_structure_ids": ["STR-05"],
      "teaching_status": "implicit",
      "frequent_reinforcement_candidate": true,
      "evidence_refs": ["bep2_p011", "bep2_act_u1_16"]
    }
  ],
