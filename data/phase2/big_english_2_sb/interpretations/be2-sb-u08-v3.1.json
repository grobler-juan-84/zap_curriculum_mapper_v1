  "language_structures": [
    {
      "id": "STR-01",
      "name": "Asking and Answering About Abilities with Modal Can (Yes/No Questions)",
      "instructional_role": "main_target",
      "pattern": "Can + subject + base verb? -> Yes, subject + can. / No, subject + can't.",
      "source_examples": [
        "Can a kangaroo jump? Yes, it can.",
        "Can snakes run? No, they can't."
      ],
      "plain_english_explanation": "Use 'Can' at the beginning of a question to ask if an animal or person has an ability, followed by the subject and base action word. Answer with 'Yes' or 'No', matching the subject pronoun and 'can' or 'can't'.",
      "components": [
        {
          "name": "Fronted modal verb 'Can'",
          "explanation": "Places 'Can' first to form a yes/no question."
        },
        {
          "name": "Subject (singular noun phrase or plural noun)",
          "explanation": "Identifies who or what is performing the action (e.g., 'a kangaroo', 'snakes')."
        },
        {
          "name": "Base form of verb",
          "explanation": "The action word without endings like -s or -ing (e.g., 'jump', 'run', 'climb')."
        },
        {
          "name": "Short answer form",
          "explanation": "Uses 'Yes, it/they can.' or 'No, it/they can't.' with subject pronoun agreement."
        }
      ],
      "evidence_refs": ["bep2_lang_u8_002", "bep2_lang_u8_003", "bep2_act_u8_09", "bep2_act_u8_10", "bep2_act_u8_12"]
    },
    {
      "id": "STR-02",
      "name": "Order of Adjectives Before Nouns (Opinion, Size/Shape, Age, Color)",
      "instructional_role": "main_target",
      "pattern": "adjective (opinion) + adjective (size/shape) + adjective (age) + adjective (color) + noun",
      "source_examples": [
        "nice, green leaves",
        "a cool blue jacket",
        "two big, green heads"
      ],
      "plain_english_explanation": "When using multiple describing words before a noun, put them in a specific order: first an opinion or feeling word, then size or shape, then age, and finally color.",
      "components": [
        {
          "name": "Opinion adjective",
          "explanation": "Words showing personal judgement or view (e.g., 'nice', 'cool', 'beautiful', 'funny')."
        },
        {
          "name": "Size/Shape adjective",
          "explanation": "Words describing physical dimensions (e.g., 'big', 'long', 'short', 'tall')."
        },
        {
          "name": "Age adjective",
          "explanation": "Words describing how old something is (e.g., 'new', 'old', 'young')."
        },
        {
          "name": "Color adjective",
          "explanation": "Words describing color (e.g., 'green', 'black', 'red', 'blue')."
        },
        {
          "name": "Head noun",
          "explanation": "The person, animal, or object being described."
        }
      ],
      "evidence_refs": ["bep2_lang_u8_004", "bep2_act_u8_20", "bep2_act_u8_21", "bep2_act_u8_22", "bep2_act_u8_23", "bep2_act_u8_36"]
    },
    {
      "id": "STR-03",
      "name": "Stating Abilities with Can and Inabilities with Can't",
      "instructional_role": "supporting",
      "pattern": "subject + can / can't + base verb",
      "source_examples": [
        "Cheetahs can run.",
        "A giraffe can't fly or jump up high."
      ],
      "plain_english_explanation": "State what an animal is able to do using 'can' plus the action, or what it is unable to do using 'can't' plus the action.",
      "components": [
        {
          "name": "Subject",
          "explanation": "The animal or person (e.g., 'Cheetahs', 'A giraffe', 'Monkeys')."
        },
        {
          "name": "Modal verb can/can't",
          "explanation": "Shows ability or lack of ability without changing form for singular or plural."
        },
        {
          "name": "Base verb",
          "explanation": "The action verb in simple root form."
        }
      ],
      "evidence_refs": ["bep2_lang_u8_001", "bep2_act_u8_06", "bep2_act_u8_08", "bep2_text_u8_01", "bep2_text_u8_02"]
    },
    {
      "id": "STR-04",
      "name": "Describing Animal Habitats with Simple Present",
      "instructional_role": "supporting",
      "pattern": "subject + live / lives in + the + habitat noun",
      "source_examples": [
        "Whales live in the ocean.",
        "Foxes live in the forest."
      ],
      "plain_english_explanation": "Explain where animals make their homes by using the verb 'live' or 'lives' followed by 'in the' and the name of the biome or habitat.",
      "components": [
        {
          "name": "Subject noun",
          "explanation": "The animal species (usually plural, e.g., 'Whales', 'Snakes')."
        },
        {
          "name": "Present simple verb (live/lives)",
          "explanation": "Agrees with singular or plural subject to state a factual habitat."
        },
        {
          "name": "Prepositional phrase of place",
          "explanation": "'in the' followed by habitat types like 'ocean', 'desert', 'forest', 'jungle'."
        }
      ],
      "evidence_refs": ["bep2_act_u8_16", "bep2_act_u8_18", "bep2_act_u8_37", "bep2_text_u8_03"]
    },
    {
      "id": "STR-05",
      "name": "Expressing Appreciation Using Intensive 'So'",
      "instructional_role": "supporting",
      "pattern": "They're / Subject + is/are + so + adjective",
      "source_examples": [
        "I like parrots. They're so beautiful.",
        "Monkeys are so smart."
      ],
      "plain_english_explanation": "Use 'so' before a descriptive adjective to emphasize strong appreciation or wonder about an animal's qualities.",
      "components": [
        {
          "name": "Subject pronoun or noun with 'be'",
          "explanation": "Points to the animals being admired (e.g., 'They're', 'Monkeys are')."
        },
        {
          "name": "Intensifier 'so'",
          "explanation": "Adds emotional emphasis meaning 'very' or 'remarkably'."
        },
        {
          "name": "Descriptive adjective",
          "explanation": "Positive trait word (e.g., 'beautiful', 'smart', 'amazing')."
        }
      ],
      "evidence_refs": ["bep2_lang_u8_005", "bep2_act_u8_29", "bep2_act_u8_30"]
    },
    {
      "id": "STR-06",
      "name": "Phonics Sound Focus: Digraphs 'ou' and 'ow'",
      "instructional_role": "main_target",
      "pattern": "Sound-spelling recognition and blending of /aʊ/ and /uː/ spelled with 'ou' and 'ow'",
      "source_examples": [
        "c-ow -> cow",
        "s-ou-p -> soup",
        "t-ow-n -> town"
      ],
      "plain_english_explanation": "Recognize and pronounce the vowel spellings 'ou' and 'ow', blending them with surrounding consonant sounds to read and chant words.",
      "components": [
        {
          "name": "Spelling pattern 'ou'",
          "explanation": "Represents vowel sounds in words such as 'soup' (/uː/) and 'group' or 'out' (/aʊ/)."
        },
        {
          "name": "Spelling pattern 'ow'",
          "explanation": "Represents vowel diphthong /aʊ/ in words like 'cow', 'owl', 'town', 'down'."
        },
        {
          "name": "Phoneme blending",
          "explanation": "Connecting individual sounds sequentially into whole words (e.g., d-ow-n -> down)."
        }
      ],
      "evidence_refs": ["bep2_vocab_u8_032", "bep2_vocab_u8_033", "bep2_vocab_u8_034", "bep2_act_u8_31", "bep2_act_u8_32", "bep2_act_u8_33", "bep2_act_u8_34", "bep2_text_u8_06"]
    }
  ],
  "foundational_skills": [
    {
      "id": "FS-01",
      "name": "Inverting Subject and Modal Auxiliary in Questions",
      "explanation": "Placing 'Can' before the subject instead of after it when turning a statement into a question.",
      "related_structure_ids": ["STR-01"],
      "teaching_status": "explicit",
      "frequent_reinforcement_candidate": true,
      "evidence_refs": ["bep2_act_u8_09", "bep2_act_u8_10"]
    },
    {
      "id": "FS-02",
      "name": "Selecting Singular vs. Plural Pronoun in Short Answers with Can",
      "explanation": "Using 'it' to refer to a singular animal ('a kangaroo -> Yes, it can') and 'they' to refer to plural animals ('snakes -> No, they can't').",
      "related_structure_ids": ["STR-01"],
      "teaching_status": "explicit",
      "frequent_reinforcement_candidate": true,
      "evidence_refs": ["bep2_lang_u8_002", "bep2_lang_u8_003", "bep2_act_u8_09", "bep2_act_u8_10"]
    },
    {
      "id": "FS-03",
      "name": "Negative Contraction 'can't'",
      "explanation": "Understanding that 'can't' is the contracted negative form of 'cannot' used in short answers and negative statements.",
      "related_structure_ids": ["STR-01", "STR-03"],
      "teaching_status": "implicit",
      "frequent_reinforcement_candidate": true,
      "evidence_refs": ["bep2_lang_u8_003", "bep2_act_u8_08", "bep2_act_u8_10"]
    },
    {
      "id": "FS-04",
      "name": "Invariable Modal Verb Agreement",
      "explanation": "Recognizing that 'can' and 'can't' do not add -s or change form whether the subject is singular (he/she/it) or plural (they).",
      "related_structure_ids": ["STR-01", "STR-03"],
      "teaching_status": "implicit",
      "frequent_reinforcement_candidate": true,
      "evidence_refs": ["bep2_act_u8_09", "bep2_act_u8_10"]
    },
    {
      "id": "FS-05",
      "name": "Commas in Direct Affirmative and Negative Short Answers",
      "explanation": "Placing a comma directly after 'Yes' or 'No' before the pronoun and modal verb ('Yes, it can.' / 'No, they can't.').",
      "related_structure_ids": ["STR-01"],
      "teaching_status": "implicit",
      "frequent_reinforcement_candidate": true,
      "evidence_refs": ["bep2_lang_u8_002", "bep2_lang_u8_003", "bep2_act_u8_09"]
    },
    {
      "id": "FS-06",
      "name": "Categorizing Adjective Types (Opinion, Size/Shape, Age, Color)",
      "explanation": "Distinguishing whether a descriptive word expresses an opinion (funny), a physical measurement (long), an age (young), or a color (green).",
      "related_structure_ids": ["STR-02"],
      "teaching_status": "explicit",
      "frequent_reinforcement_candidate": true,
      "evidence_refs": ["bep2_act_u8_20", "bep2_act_u8_22"]
    },
    {
      "id": "FS-07",
      "name": "Prenominal Adjective Placement and Comma Usage",
      "explanation": "Placing modifying adjectives before the noun rather than after it, and using a comma between coordinate adjectives of distinct categories where appropriate.",
      "related_structure_ids": ["STR-02"],
      "teaching_status": "explicit",
      "frequent_reinforcement_candidate": true,
      "evidence_refs": ["bep2_lang_u8_004", "bep2_act_u8_21", "bep2_act_u8_23", "bep2_act_u8_36"]
    },
    {
      "id": "FS-08",
      "name": "Singular vs. Plural Animal Noun Formation",
      "explanation": "Forming regular plural animal nouns with -s (cheetahs, kangaroos, monkeys, snakes) and recognizing singular nouns with 'a/an' (a giraffe, an elephant).",
      "related_structure_ids": ["STR-01", "STR-03", "STR-04"],
      "teaching_status": "implicit",
      "frequent_reinforcement_candidate": true,
      "evidence_refs": ["bep2_vocab_u8_001", "bep2_vocab_u8_010", "bep2_vocab_u8_012", "bep2_act_u8_10", "bep2_act_u8_11"]
    },
    {
      "id": "FS-09",
      "name": "Digraph Phonic Decoding for 'ou' and 'ow'",
      "explanation": "Blending onset consonants with rime digraphs containing 'ou' or 'ow' to read target monosyllabic words accurately.",
      "related_structure_ids": ["STR-06"],
      "teaching_status": "explicit",
      "frequent_reinforcement_candidate": false,
      "evidence_refs": ["bep2_act_u8_31", "bep2_act_u8_32", "bep2_act_u8_33"]
    }
  ],
