# Frontend (Vite) — safe public values only
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only — never prefix with VITE_; never commit real values
# Prefer root `.env` / `.env.local` for scripts; avoid shipping service role via Vite.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side / Python only — never expose through the Vite frontend
GEMINI_API_KEY=

# Cloudflare R2 (S3-compatible) — server-side / ops scripts only (D010 / D011)
# Copy these into root `.env.local` (gitignored). Never use VITE_* for R2 secrets.
# Endpoint is derived as: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# Vite middleware reads these for POST /api/sign-source-pdf (never bundled to the browser).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=book-sources

# PDF.js needs R2 bucket CORS for localhost (GET/HEAD). Object Read/Write tokens
# often cannot PutBucketCors — set in Cloudflare dashboard if needed:
#   Origins: http://localhost:5173 , http://127.0.0.1:5173
#   Methods: GET, HEAD
# Script (inspect / apply when permitted): node scripts/configure_r2_cors.mjs
