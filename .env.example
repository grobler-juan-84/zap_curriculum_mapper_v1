# Frontend (Vite) — safe public values only
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opener-only neutral-package canary (default OFF). Local developers only.
# Put in app/.env.local (preferred) or root .env.local, then restart `npm run dev`.
# Enable:  VITE_CHALKIE_BE3_U08_OPENER_NEUTRAL_CANARY=true
# Disable: unset the variable, or set to false / 0
# VITE_CHALKIE_BE3_U08_OPENER_NEUTRAL_CANARY=

# Opener-only optional BI framing on Chalkie detailed handoff (default OFF).
# When on, appends labelled phase2_interpretation planning context after the
# handoff body. Does not change outlines/vocab or page evidence (D022).
# Enable:  VITE_CHALKIE_BE3_U08_OPENER_BI_FRAMING=true
# VITE_CHALKIE_BE3_U08_OPENER_BI_FRAMING=

# Story-only neutral-package canary (default OFF). Local developers only.
# Exact scope: BE3 U8 SB 130–131 → WB 106 only (never WB 107).
# Enable:  VITE_CHALKIE_BE3_U08_STORY_NEUTRAL_CANARY=true
# Disable: unset the variable, or set to false / 0
# Status: IMPLEMENTED / AWAITING OWNER MANUAL CHECK
# VITE_CHALKIE_BE3_U08_STORY_NEUTRAL_CANARY=

# BE3 U8 SB pp.128-129 activity-enrichment POC (default OFF).
# Exact scope: five human-verified activities only. Experimental sidecars and
# lesson-package projection only; no production generation routing.
# Enable:  VITE_CHALKIE_BE3_U08_ACTIVITY_ENRICHMENT_POC=true
# Disable: unset the variable, or set to false / 0
# VITE_CHALKIE_BE3_U08_ACTIVITY_ENRICHMENT_POC=

# BE3 U8 NLL pilot shadow package (default OFF). Local developers only.
# Read-only pilot retrieval/package comparison; does not change production routing or UI.
# Enable:  VITE_CHALKIE_NLL_SHADOW_PILOT=true
# Disable: unset the variable, or set to false / 0
# VITE_CHALKIE_NLL_SHADOW_PILOT=

# BE3 U8 Opener NLL↔POC activity-card comparison (default OFF). Local developers only.
# Exact scope: nine Opener activities (SB 128–129 + WB 104–105). Independent of
# enrichment POC, NLL shadow pilot, and Opener/Story neutral canaries.
# When on, modal cards show POC and NLL summaries side by side; NLL rows stay
# hidden/experimental. Not a POC replacement until owner acceptance.
# Enable:  VITE_CHALKIE_NLL_CARD_COMPARISON=true
# Disable: unset the variable, or set to false / 0
VITE_CHALKIE_NLL_CARD_COMPARISON=false

# Stage 4 NLL → NLP → General Lesson Plan pilot (default OFF). Local developers only.
# Exact BE3 U8 Opener scope; triggered only when the teacher chooses General Lesson Plan.
# Independent of Stage 3 card comparison, enrichment POC, NLL shadow pilot, and canaries.
# May read hidden experimental NLL summaries without promoting visibility or review state.
# Enable:  VITE_NLL_GENERAL_LESSON_PLAN_PILOT=true
# Disable: unset the variable, or set to false / 0
VITE_NLL_GENERAL_LESSON_PLAN_PILOT=false

# Stage 5 NLL -> NLP -> Chalkie adapter pilot (default OFF). Local developers only.
# Exact BE3 U8 Opener scope; triggered only for the two-lesson SB/WB Chalkie package.
# NLL summaries remain package-only; existing bespoke/canary paths are the fallback.
# Enable:  VITE_NLL_CHALKIE_ADAPTER_PILOT=true
# Disable: unset the variable, or set to false / 0
VITE_NLL_CHALKIE_ADAPTER_PILOT=false

# Stage 6B NLL -> NLP -> Chalkie Story adapter pilot (default OFF). Local developers only.
# Exact BE3 U8 Story scope (SB pp.130–131 → WB p.106); two-lesson SB/WB Chalkie package only.
# Independent of Stage 5 Opener flag and Story neutral canary. NLL summaries stay package-only.
# Enable:  VITE_NLL_CHALKIE_STORY_ADAPTER_PILOT=true
# Disable: unset the variable, or set to false / 0
VITE_NLL_CHALKIE_STORY_ADAPTER_PILOT=false

# LiA-C NLL -> NLP -> Chalkie Language in Action adapter pilot (default OFF). Local developers only.
# Exact BE3 U8 LiA scope (SB pp.132–133 → WB pp.107–108); Create-a-prompt two-lesson series only.
# Independent of Stage 5 Opener, Stage 6B Story, and Story canary. Resolver default stays sb_only.
# NLL summaries stay package-only; LiA remains BI-absent. Fallback is the current sb_only path.
# Enable:  VITE_NLL_CHALKIE_LIA_ADAPTER_PILOT=true
# Disable: unset the variable, or set to false / 0
VITE_NLL_CHALKIE_LIA_ADAPTER_PILOT=false

# Grammar-C NLL -> NLP -> Chalkie Grammar adapter pilot (default OFF). Local developers only.
# Exact BE3 U8 Grammar scope (SB pp.136–137 → WB pp.111–112); Create-a-prompt two-lesson series only.
# Independent of Opener, Story, and LiA adapters. Resolver default stays sb_only.
# NLL summaries stay package-only; Grammar remains BI-absent. Fallback is the current sb_only path.
# Enable:  VITE_NLL_CHALKIE_GRAMMAR_ADAPTER_PILOT=true
# Disable: unset the variable, or set to false / 0
VITE_NLL_CHALKIE_GRAMMAR_ADAPTER_PILOT=false

# CLIL-C NLL -> NLP -> Chalkie Content Connection / P.E. adapter pilot (default OFF). Local developers only.
# Exact BE3 U8 CLIL/P.E. scope (SB pp.134–135 → WB pp.109–110); Create-a-prompt two-lesson series only.
# Independent of Opener, Story, LiA, and Grammar adapters. Resolver default stays sb_only.
# NLL summaries stay package-only; CLIL remains BI-absent. Fallback is the current sb_only path.
# Enable:  VITE_NLL_CHALKIE_CLIL_PE_ADAPTER_PILOT=true
# Disable: unset the variable, or set to false / 0
VITE_NLL_CHALKIE_CLIL_PE_ADAPTER_PILOT=false

# Culture-C NLL -> NLP -> Chalkie Culture Connection adapter pilot (default OFF). Local developers only.
# Exact BE3 U8 Culture scope (SB pp.138–139 → WB pp.113–114); Create-a-prompt two-lesson series only.
# Independent of Opener, Story, LiA, Grammar, and CLIL adapters. Resolver default stays sb_only.
# NLL summaries stay package-only; Culture remains BI-absent. Fallback is the current sb_only path.
# Enable:  VITE_NLL_CHALKIE_CULTURE_ADAPTER_PILOT=true
# Disable: unset the variable, or set to false / 0
VITE_NLL_CHALKIE_CULTURE_ADAPTER_PILOT=false

# Writing-C NLL -> NLP -> Chalkie Writing adapter pilot (default OFF). Local developers only.
# Exact BE3 U8 Writing scope (SB p.140 → WB p.115); Create-a-prompt two-lesson series only.
# Independent of Opener, Story, LiA, Grammar, CLIL, and Culture adapters. Resolver default stays sb_only.
# NLL summaries stay package-only; Writing remains BI-absent. Fallback is the current sb_only path.
# Enable:  VITE_NLL_CHALKIE_WRITING_ADAPTER_PILOT=true
# Disable: unset the variable, or set to false / 0
VITE_NLL_CHALKIE_WRITING_ADAPTER_PILOT=false

# Phonics-C NLL -> NLP -> Chalkie Phonics adapter pilot (default OFF). Local developers only.
# Exact BE3 U8 Phonics scope (SB p.141 → WB p.116); Create-a-prompt two-lesson series only.
# Independent of every other component adapter. Resolver default stays sb_only.
# NLL summaries stay package-only; Phonics remains BI-absent. Fallback is the current sb_only path.
# Enable:  VITE_NLL_CHALKIE_PHONICS_ADAPTER_PILOT=true
# Disable: unset the variable, or set to false / 0
VITE_NLL_CHALKIE_PHONICS_ADAPTER_PILOT=false

# Review-C NLL -> NLP -> Chalkie Review adapter pilot (default OFF). Local developers only.
# Exact BE3 U8 Review scope (SB p.143 → WB p.117); Create-a-prompt two-lesson series only.
# Mixed consolidation only — no earlier-component aggregation. Resolver default stays sb_only.
# NLL summaries stay package-only; Review remains BI-absent. Fallback is the current sb_only path.
# Enable:  VITE_NLL_CHALKIE_REVIEW_ADAPTER_PILOT=true
# Disable: unset the variable, or set to false / 0
VITE_NLL_CHALKIE_REVIEW_ADAPTER_PILOT=false

# Server-side only — never prefix with VITE_; never commit real values
# Prefer root `.env` / `.env.local` for scripts; avoid shipping service role via Vite.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side / Python only — never expose through the Vite frontend
GEMINI_API_KEY=

# OpenAI — server-side only. Never use VITE_* / NEXT_PUBLIC_* / REACT_APP_*.
# Put real values in root `.env.local` (gitignored), then restart `npm run dev` in `app/`.
# Vite middleware reads these via loadServerEnv — never the browser.
OPENAI_API_KEY=
# Preferred model for POST /api/chalkie/generate (lesson draft). Required for that route.
OPENAI_MODEL=
# Legacy alias still used by POST /api/generate-chalkie-prompt (older evidence-to-prompt path).
# OPENAI_CHALKIE_MODEL=gpt-4o-mini

# Cloudflare R2 (S3-compatible) — server-side / ops scripts only (D010 / D011)
# Copy these into root `.env.local` (gitignored). Never use VITE_* for R2 secrets.
# Endpoint is derived as: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# Vite middleware reads these for POST /api/sign-source-pdf (never bundled to the browser).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=book-sources

# PDF.js needs R2 bucket CORS for localhost (GET/HEAD). Object Read/Write tokens
# often cannot PutBucketCors — set in Cloudflare dashboard if needed:
#   Origins: http://localhost:5173 , http://127.0.0.1:5173
#   Methods: GET, HEAD
# Script (inspect / apply when permitted): node scripts/configure_r2_cors.mjs
